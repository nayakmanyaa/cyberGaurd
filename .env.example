# ==========================================
# CyberGuard Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ==========================================

# --- MongoDB Configuration (connection settings only; client added in storage phase) ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=cyberguard
MONGO_ALERTS_COLLECTION=alerts
MONGO_RECORDS_COLLECTION=investigation_records

# --- Neo4j Configuration (connection settings only; driver added in graph phase) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j

# --- Java & PySpark ---
# On WSL2 Ubuntu: /usr/lib/jvm/java-17-openjdk-amd64
JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
SPARK_APP_NAME=CyberGuard-Analytics
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=2g
SPARK_SHUFFLE_PARTITIONS=4

# --- Data Paths ---
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
SAMPLE_DATA_DIR=data/sample

# --- Threat Detection Thresholds (Configurable) ---
HIGH_CONN_FREQ_ZSCORE=2.5
HIGH_TRAFFIC_VOL_ZSCORE=2.5
PORT_SCAN_UNIQUE_PORTS_THRESHOLD=20
FAILED_CONN_THRESHOLD=10
OUTBOUND_RATIO_THRESHOLD=5.0
